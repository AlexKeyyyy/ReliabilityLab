импорт Стд::HttpСервисы
импорт Стд::ВводВывод
импорт Стд::Json

метод СоздатьПрогон(Запрос: HttpСервисЗапрос)
    Выполнить(Запрос, "run")
;

метод ПринятьСообщение(Запрос: HttpСервисЗапрос)
    Выполнить(Запрос, "receive")
;

метод ОбработатьОперацию(Запрос: HttpСервисЗапрос)
    Выполнить(Запрос, "process")
;

метод ПовторитьОперацию(Запрос: HttpСервисЗапрос)
    Выполнить(Запрос, "retry")
;

метод ПолучитьОперацию(Запрос: HttpСервисЗапрос)
    Выполнить(Запрос, "state")
;

метод ПолучитьСобытия(Запрос: HttpСервисЗапрос)
    Выполнить(Запрос, "events")
;

метод Выполнить(Запрос: HttpСервисЗапрос, Команда: Строка)
    попытка
        // Сериализация запроса строго типизирована: лишние/отсутствующие поля
        // не должны молча получать значения по умолчанию.
        знч Настройки = новый НастройкиЧтенияОбъектовJson()
        Настройки.ИгнорироватьНеизвестныеСвойства = Ложь
        Настройки.ИнициализироватьОтсутствующиеПоля = Ложь
        пер Ответ: ОтветВызова
        если Команда == "state" или Команда == "events"
            знч ИдОперации = Запрос.Параметры.ПолучитьПервый("id") ?? ""
            если Команда == "state"
                Ответ = ОбработкаОпераций.ПолучитьОперацию(ИдОперации)
            иначе
                знч Курсор = Запрос.Параметры.ПолучитьПервый("cursor") ?? ""
                если Курсор != ""
                    КонтрактApi.ПроверитьПопытку(Курсор)
                ;
                Ответ = ОбработкаОпераций.ПолучитьСобытия(ИдОперации, Курсор)
            ;
        иначе
            знч ТипСодержимого = Запрос.Заголовки.ПолучитьПервый("Content-Type") ?? ""
            если не ТипСодержимого.ПолноеСовпадение('application/json([;].*)?')
                Отправить(Запрос, КонтрактApi.Ошибка(415, "UNSUPPORTED_MEDIA_TYPE", "Use application/json"))
                возврат
            ;
            знч БайтыТела = Запрос.Тело.ПрочитатьКакБайты()
            если БайтыТела.Размер() > 16кб
                Отправить(Запрос, КонтрактApi.Ошибка(413, "BODY_TOO_LARGE", "Request body exceeds 16 KiB"))
                возврат
            ;
            знч Тело = ПотокЧтения.ИзБайтов(БайтыТела).ПрочитатьКакСтроку()
            выбор Команда
            когда "run"
                знч Данные = СериализацияJson.ПрочитатьОбъект<ПрогонApi>(Тело, Настройки)
                Ответ = ОбработкаОпераций.СоздатьПрогон(Данные)
            когда "receive"
                знч Данные = СериализацияJson.ПрочитатьОбъект<СообщениеApi>(Тело, Настройки)
                Ответ = ОбработкаОпераций.Принять(Данные)
            иначе
                знч Данные = СериализацияJson.ПрочитатьОбъект<ОбработкаApi>(Тело, Настройки)
                Ответ = ОбработкаОпераций.Обработать(Запрос.Параметры.ПолучитьПервый("id") ?? "", Данные.ИдПопытки, Команда)
            ;
        ;
        // Бизнес-метод уже вышел из области основной транзакции.
        Отправить(Запрос, Ответ)
    поймать Ошибка: ИсключениеЧтенияJson
        Отправить(Запрос, КонтрактApi.Ошибка(400, "INVALID_JSON", "Invalid JSON shape or field types"))
    поймать Ошибка: ИсключениеНедопустимыйАргумент
        Отправить(Запрос, КонтрактApi.Ошибка(400, "VALIDATION_ERROR", Ошибка.Описание))
    поймать Ошибка: ИсключениеНедопустимыйФормат
        Отправить(Запрос, КонтрактApi.Ошибка(400, "VALIDATION_ERROR", "Invalid timestamp or field format"))
    поймать Ошибка: Исключение
        // HTTP 500 не доказывает откат: клиента направляем к устойчивому состоянию.
        Отправить(Запрос, КонтрактApi.Ошибка(500, "OUTCOME_UNCONFIRMED", "Read the durable operation state before retrying", Истина))
    ;
;

метод Отправить(Запрос: HttpСервисЗапрос, Ответ: ОтветВызова)
    Запрос.Ответ.УстановитьКодСтатуса(Ответ.Код)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json; charset=utf-8")
    Запрос.Ответ.Заголовки.Установить("Cache-Control", "no-store")
    Запрос.Ответ.УстановитьТело(Ответ.Тело)
;

метод ПроверитьДоступность(Запрос: HttpСервисЗапрос)
    Запрос.Ответ.УстановитьКодСтатуса(200)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "text/plain")
    Запрос.Ответ.УстановитьТело("ReliabilityLab C API 1.0")
;

импорт Стд::РегулярныеВыражения

метод ЗагрузитьМетрики(Команда: ОбычнаяКоманда)
    Метрики = СформироватьПодписьМетрик(ИдПрогона)
;

@НаСервере @ДоступноСКлиента
статический метод СформироватьПодписьМетрик(ИдПрогона: Строка): Строка
    если не ИдПрогона.ПолноеСовпадение('[A-Za-z0-9_-]{1,96}')
        возврат "Enter a valid Run ID from the Runs list."
    ;
    знч Данные = ОбработкаОпераций.ПрочитатьМетрикиПрогона(ИдПрогона)
    если Данные == Неопределено
        возврат "Run not found. Check the Run ID in the Runs list."
    ;
    знч Стратегия = Данные.Получить("strategy")
    знч Получено = Данные.Получить("received")
    знч Завершено = Данные.Получить("completed")
    знч Заказы = Данные.Получить("business_effect_count")
    знч Повторы = Данные.Получить("duplicate_attempts")
    знч Дубли = Данные.Получить("duplicate_business_effects")
    возврат "Run ${ИдПрогона} | Strategy ${Стратегия} | Received ${Получено} | Completed ${Завершено}"
        + " | Orders ${Заказы} | Duplicate attempts ${Повторы} | Duplicate orders ${Дубли} | Sent N/A | Unknown N/A"
;

метод ОткрытьВходящиеОперации(Источник: Карточка, Событие: СобытиеПриНажатии)
    ВходящиеОперацииФормаСписка.Открыть()
;

метод ОткрытьЗаказы(Источник: Карточка, Событие: СобытиеПриНажатии)
    ЗаказыФормаСписка.Открыть()
;

метод ОткрытьПрогоны(Источник: Карточка, Событие: СобытиеПриНажатии)
    ПрогоныФормаСписка.Открыть()
;

метод ОткрытьПопыткиЗапросов(Источник: Карточка, Событие: СобытиеПриНажатии)
    ПопыткиЗапросовФормаСписка.Открыть()
;

метод ОткрытьСобытияОпераций(Источник: Карточка, Событие: СобытиеПриНажатии)
    СобытияОперацийФормаСписка.Открыть()
;

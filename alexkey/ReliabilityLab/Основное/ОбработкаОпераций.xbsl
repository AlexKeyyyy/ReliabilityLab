импорт Стд::БазаДанных
импорт Стд::Сущности::Блокировки
импорт Стд::Время
импорт Стд::Коллекции
импорт Стд::Json

// Все точки записи используют порядок: операция -> попытка. Основная транзакция
// принадлежит этому модулю; HTTP-ответ отправляет вызывающий код после возврата.
@ВПодсистеме
метод СоздатьПрогон(Данные: ПрогонApi): ОтветВызова
    КонтрактApi.ПроверитьПрогон(Данные)
    Транзакции.ПроверитьНетАктивной()
    исп Транзакции.Начать()
    Блокировки.Заблокировать(новый Прогоны.Блокировки.КлючЗаписи(ИдПрогона = Данные.ИдПрогона))
    знч Ключ = новый Прогоны.КлючЗаписи(ИдПрогона = Данные.ИдПрогона)
    знч Существующий = Ключ.ЗагрузитьЗапись()
    знч Конфигурация = КонтрактApi.Json(Данные)
    если Существующий != Неопределено
        если Существующий.КонфигурацияJson != Конфигурация
            возврат КонтрактApi.Ошибка(409, "RUN_CONFIG_CONFLICT", "Run configuration is immutable")
        ;
        возврат КонтрактApi.Ответ(200, {"run_id": Данные.ИдПрогона, "strategy": "C", "replayed": Истина})
    ;
    Прогоны.Записать(новый Прогоны.Запись(
        ИдПрогона = Данные.ИдПрогона, Стратегия = Данные.Стратегия,
        Сценарий = Данные.Сценарий, КонфигурацияJson = Конфигурация, Создан = Момент.Сейчас()
    ))
    возврат КонтрактApi.Ответ(201, {"run_id": Данные.ИдПрогона, "strategy": "C", "replayed": Ложь})
;

@ВПодсистеме
метод Принять(Данные: СообщениеApi): ОтветВызова
    знч СозданоКлиентом = КонтрактApi.ПроверитьСообщение(Данные)
    Транзакции.ПроверитьНетАктивной()
    исп Транзакции.Начать()
    ЗаблокироватьОперацию(Данные.ИдОперации)
    ЗаблокироватьПопытку(Данные.ИдПопытки)
    знч Прогон = (новый Прогоны.КлючЗаписи(ИдПрогона = Данные.ИдПрогона)).ЗагрузитьЗапись()
    если Прогон == Неопределено
        возврат КонтрактApi.Ошибка(404, "RUN_NOT_FOUND", "Create the run before receiving a message")
    ;
    знч Ключ = новый ВходящиеОперации.КлючЗаписи(ИдОперации = Данные.ИдОперации)
    пер Операция = Ключ.ЗагрузитьЗапись()
    если Операция != Неопределено
        если Операция.ИдПрогона != Данные.ИдПрогона или Операция.ВнешнийИдЗаказа != Данные.ИдЗаказа или Операция.СуммаВКопейках != Данные.СуммаВКопейках или Операция.Валюта != Данные.Валюта или Операция.СозданКлиентом != СозданоКлиентом
            возврат КонтрактApi.Ошибка(409, "OPERATION_PAYLOAD_CONFLICT", "Operation payload differs from the stored payload")
        ;
    ;
    // Сериализация DTO задаёт постоянный порядок полей. Время нормализуется
    // отдельно: разные допустимые текстовые формы одного момента эквивалентны.
    знч Содержимое = КонтрактApi.Json({
        "operation_id": Данные.ИдОперации, "run_id": Данные.ИдПрогона,
        "order_id": Данные.ИдЗаказа, "amount_minor": Данные.СуммаВКопейках,
        "currency": Данные.Валюта, "created_at": СозданоКлиентом.ВСтроку()
    })
    знч Предыдущая = ПрочитатьПопытку(Данные.ИдПопытки)
    если Предыдущая != Неопределено
        возврат ПовторПопытки(Предыдущая, Данные.ИдОперации, "receive", Содержимое)
    ;
    знч Сейчас = Момент.Сейчас()
    пер Код = 200
    знч ЭтоПовтор = Операция != Неопределено
    если Операция == Неопределено
        Операция = новый ВходящиеОперации.Запись(
            ИдОперации = Данные.ИдОперации, ИдПрогона = Данные.ИдПрогона,
            ВнешнийИдЗаказа = Данные.ИдЗаказа, СуммаВКопейках = Данные.СуммаВКопейках,
            Валюта = Данные.Валюта, СозданКлиентом = СозданоКлиентом,
            Принято = Сейчас, Состояние = "RECEIVED", РезультатJson = "", СбойНазначен = Ложь
        )
        ВходящиеОперации.Записать(Операция)
        Код = 201
        Событие(Данные.ИдОперации, Данные.ИдПрогона, Данные.ИдПопытки, "PERSISTED")
    иначе
        Событие(Данные.ИдОперации, Данные.ИдПрогона, Данные.ИдПопытки, "DUPLICATE_RECEIVE")
    ;
    знч Ответ = КонтрактApi.Ответ(Код, {
        "schema_version": 1, "operation_id": Данные.ИдОперации,
        "run_id": Данные.ИдПрогона, "server_state": Операция.Состояние,
        "durable_stage": "INBOX_PERSISTED", "received_at": Операция.Принято.ВСтроку(),
        "replayed": ЭтоПовтор
    })
    ПопыткиЗапросов.Записать(новый ПопыткиЗапросов.Запись(
        ИдПопытки = Данные.ИдПопытки, ИдОперации = Данные.ИдОперации,
        ИдПрогона = Данные.ИдПрогона, Команда = "receive", СодержимоеJson = Содержимое,
        Начато = Сейчас, Завершено = Сейчас, Исход = "SUCCEEDED",
        КодОтвета = Ответ.Код, ОтветJson = Ответ.Тело, ВвестиСбой = Ложь
    ))
    возврат Ответ
;

@ВПодсистеме
метод Обработать(ИдОперации: Строка, ИдПопытки: Строка, Команда: Строка): ОтветВызова
    КонтрактApi.ПроверитьИд(ИдОперации)
    КонтрактApi.ПроверитьПопытку(ИдПопытки)
    Транзакции.ПроверитьНетАктивной()
    знч ПредыдущийОтвет = ЗарегистрироватьОбработку(ИдОперации, ИдПопытки, Команда)
    если ПредыдущийОтвет != Неопределено
        возврат ПредыдущийОтвет
    ;
    попытка
        возврат ВыполнитьБизнесТранзакцию(ИдОперации, ИдПопытки)
    поймать Ошибка: Исключение
        если Ошибка.Описание == "INJECTED_BEFORE_COMMIT"
            // Этот маркер возникает только из тела основной T2 до фиксации.
            возврат ЗафиксироватьОткат(ИдОперации, ИдПопытки)
        ;
        возврат КонтрактApi.Ошибка(500, "OUTCOME_UNCONFIRMED", "Read the durable operation state before retrying", Истина)
    ;
;

метод ЗарегистрироватьОбработку(ИдОперации: Строка, ИдПопытки: Строка, Команда: Строка): ОтветВызова?
    исп Транзакции.Начать()
    ЗаблокироватьОперацию(ИдОперации)
    ЗаблокироватьПопытку(ИдПопытки)
    знч Операция = (новый ВходящиеОперации.КлючЗаписи(ИдОперации = ИдОперации)).ЗагрузитьЗапись()
    если Операция == Неопределено
        возврат КонтрактApi.Ошибка(404, "OPERATION_NOT_FOUND", "Receive a message before processing")
    ;
    знч Предыдущая = ПрочитатьПопытку(ИдПопытки)
    если Предыдущая != Неопределено
        возврат ПовторПопытки(Предыдущая, ИдОперации, Команда, "")
    ;
    знч Прогон = (новый Прогоны.КлючЗаписи(ИдПрогона = Операция.ИдПрогона)).ЗагрузитьЗапись()
    если Прогон == Неопределено или Прогон.Стратегия != "C"
        возврат КонтрактApi.Ошибка(409, "RUN_CONFIG_CONFLICT", "A strategy C run is required")
    ;
    знч ВвестиСбой = Прогон.Сценарий == "fail_before_commit" и не Операция.СбойНазначен и Операция.Заказ == Неопределено
    если ВвестиСбой
        Операция.СбойНазначен = Истина
        ВходящиеОперации.Записать(Операция)
    ;
    ПопыткиЗапросов.Записать(новый ПопыткиЗапросов.Запись(
        ИдПопытки = ИдПопытки, ИдОперации = ИдОперации, ИдПрогона = Операция.ИдПрогона,
        Команда = Команда, СодержимоеJson = "", Начато = Момент.Сейчас(),
        Исход = "STARTED", ОтветJson = "", КодОтвета = 0, ВвестиСбой = ВвестиСбой
    ))
    Событие(ИдОперации, Операция.ИдПрогона, ИдПопытки, "PROCESS_STARTED")
    возврат Неопределено
;

метод ВыполнитьБизнесТранзакцию(ИдОперации: Строка, ИдПопытки: Строка): ОтветВызова
    Транзакции.ПроверитьНетАктивной()
    исп Транзакции.Начать()
    ЗаблокироватьОперацию(ИдОперации)
    ЗаблокироватьПопытку(ИдПопытки)
    знч Операция = (новый ВходящиеОперации.КлючЗаписи(ИдОперации = ИдОперации)).ЗагрузитьЗапись()!
    знч Попытка = ПрочитатьПопытку(ИдПопытки)!
    знч ЭтоПовтор = Операция.Заказ != Неопределено
    если не ЭтоПовтор
        знч Сейчас = Момент.Сейчас()
        знч Заказ = новый Заказы.Объект()
        Заказ.Дата = ДатаВремя.Сейчас()
        Заказ.ИдОперации = ИдОперации
        Заказ.ИдПрогона = Операция.ИдПрогона
        Заказ.ВнешнийИдЗаказа = Операция.ВнешнийИдЗаказа
        Заказ.СуммаВКопейках = Операция.СуммаВКопейках
        Заказ.Валюта = Операция.Валюта
        Заказ.ИдПопытки = ИдПопытки
        Заказ.Создан = Сейчас
        Заказ.Записать()
        если Попытка.ВвестиСбой
            выбросить новый ИсключениеНедопустимоеСостояние("INJECTED_BEFORE_COMMIT")
        ;
        Операция.Заказ = Заказ.Ссылка
        Операция.Завершено = Сейчас
        Операция.Состояние = "COMPLETED"
        Операция.РезультатJson = КонтрактApi.Json({
            "order_ref": Заказ.Ссылка.Ид.ВСтроку(), "order_id": Заказ.ВнешнийИдЗаказа,
            "amount_minor": Заказ.СуммаВКопейках, "currency": Заказ.Валюта,
            "completed_at": Сейчас.ВСтроку()
        })
        ВходящиеОперации.Записать(Операция)
        Событие(ИдОперации, Операция.ИдПрогона, ИдПопытки, "BUSINESS_COMMITTED")
    иначе
        Событие(ИдОперации, Операция.ИдПрогона, ИдПопытки, "RESULT_REPLAYED")
    ;
    знч Результат = СериализацияJson.ПрочитатьОбъект<Соответствие<Строка, Объект?>>(Операция.РезультатJson, новый НастройкиЧтенияОбъектовJson())
    знч Ответ = КонтрактApi.Ответ(200, {
        "schema_version": 1, "operation_id": ИдОперации, "run_id": Операция.ИдПрогона,
        "attempt_id": ИдПопытки, "server_state": "COMPLETED",
        "durable_stage": "BUSINESS_COMMITTED", "replayed": ЭтоПовтор, "result": Результат
    })
    Попытка.Завершено = Момент.Сейчас()
    если ЭтоПовтор
        Попытка.Исход = "REPLAYED"
    иначе
        Попытка.Исход = "SUCCEEDED"
    ;
    Попытка.КодОтвета = Ответ.Код
    Попытка.ОтветJson = Ответ.Тело
    ПопыткиЗапросов.Записать(Попытка)
    возврат Ответ
;

метод ЗафиксироватьОткат(ИдОперации: Строка, ИдПопытки: Строка): ОтветВызова
    исп Транзакции.Начать()
    ЗаблокироватьОперацию(ИдОперации)
    ЗаблокироватьПопытку(ИдПопытки)
    знч Попытка = ПрочитатьПопытку(ИдПопытки)!
    знч Ответ = КонтрактApi.Ошибка(500, "INJECTED_BEFORE_COMMIT", "The injected attempt was rolled back; retry with a new attempt_id", Истина)
    Попытка.Завершено = Момент.Сейчас()
    Попытка.Исход = "FAILED"
    Попытка.КодОтвета = Ответ.Код
    Попытка.ОтветJson = Ответ.Тело
    ПопыткиЗапросов.Записать(Попытка)
    Событие(ИдОперации, Попытка.ИдПрогона, ИдПопытки, "ROLLED_BACK")
    возврат Ответ
;

@ВПодсистеме
метод ПолучитьОперацию(ИдОперации: Строка): ОтветВызова
    КонтрактApi.ПроверитьИд(ИдОперации)
    Транзакции.ПроверитьНетАктивной()
    исп Транзакции.Начать()
    // Согласованный снимок: состояние операции и фактические заказы не должны
    // оказаться по разные стороны конкурентного commit.
    Блокировки.Заблокировать(новый ВходящиеОперации.Блокировки.КлючЗаписи(
        РежимБлокировки = РежимБлокировки.Разделяемый, ИдОперации = ИдОперации
    ))
    знч Операция = (новый ВходящиеОперации.КлючЗаписи(ИдОперации = ИдОперации)).ЗагрузитьЗапись()
    если Операция == Неопределено
        возврат КонтрактApi.Ошибка(404, "OPERATION_NOT_FOUND", "Unknown operation")
    ;
    знч ЗапросЗаказов = Запрос{
        ВЫБРАТЬ Заказ.Ссылка КАК Ссылка, Заказ.ВнешнийИдЗаказа КАК ИдЗаказа,
            Заказ.СуммаВКопейках КАК Сумма, Заказ.Валюта КАК Валюта, Заказ.Создан КАК Создан
        ИЗ Заказы КАК Заказ
        ГДЕ Заказ.ИдОперации == %ИдОперации
        УПОРЯДОЧИТЬ ПО Заказ.Создан
    }
    знч ЗаказыОперации: Массив<Соответствие<Строка, Объект?>> = []
    для Заказ из ЗапросЗаказов.Выполнить()
        ЗаказыОперации.Добавить({"order_ref": Заказ.Ссылка.Ид.ВСтроку(), "order_id": Заказ.ИдЗаказа,
            "amount_minor": Заказ.Сумма, "currency": Заказ.Валюта, "created_at": Заказ.Создан.ВСтроку()})
    ;
    знч ЗапросПопытки = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 Попытка.Исход КАК Исход
        ИЗ ПопыткиЗапросов КАК Попытка
        ГДЕ Попытка.ИдОперации == %ИдОперации
        УПОРЯДОЧИТЬ ПО Попытка.Начато УБЫВ, Попытка.ИдПопытки УБЫВ
    }
    знч Последняя = ЗапросПопытки.Выполнить().ПервыйИлиНеопределено()
    возврат КонтрактApi.Ответ(200, {
        "schema_version": 1, "operation_id": ИдОперации, "run_id": Операция.ИдПрогона,
        "server_state": Операция.Состояние, "last_attempt_outcome": Последняя?.Исход,
        "business_effect_count": ЗаказыОперации.Размер(), "orders": ЗаказыОперации,
        "received_at": Операция.Принято.ВСтроку()
    })
;

@ВПодсистеме
метод ПолучитьСобытия(ИдОперации: Строка, Курсор: Строка): ОтветВызова
    КонтрактApi.ПроверитьИд(ИдОперации)
    если (новый ВходящиеОперации.КлючЗаписи(ИдОперации = ИдОперации)).ЗагрузитьЗапись() == Неопределено
        возврат КонтрактApi.Ошибка(404, "OPERATION_NOT_FOUND", "Unknown operation")
    ;
    знч ЗапросСобытий = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 101 Событие.ИдСобытия КАК Ид, Событие.ИдПопытки КАК Попытка,
            Событие.ТипСобытия КАК Вид, Событие.Источник КАК Источник, Событие.Произошло КАК Время
        ИЗ СобытияОпераций КАК Событие
        ГДЕ Событие.ИдОперации == %ИдОперации И Событие.ИдСобытия > %Курсор
        УПОРЯДОЧИТЬ ПО Событие.ИдСобытия
    }
    знч События: Массив<Соответствие<Строка, Объект?>> = []
    пер СледующийКурсор: Строка? = Неопределено
    пер ПоследнийИд = ""
    для СтрокаСобытия из ЗапросСобытий.Выполнить()
        если События.Размер() == 100
            СледующийКурсор = ПоследнийИд
            прервать
        ;
        ПоследнийИд = СтрокаСобытия.Ид
        События.Добавить({"event_id": СтрокаСобытия.Ид, "attempt_id": СтрокаСобытия.Попытка,
            "event_type": СтрокаСобытия.Вид, "source": СтрокаСобытия.Источник,
            "occurred_at": СтрокаСобытия.Время.ВСтроку()})
    ;
    возврат КонтрактApi.Ответ(200, {"operation_id": ИдОперации, "events": События, "next_cursor": СледующийКурсор})
;

метод ПрочитатьПопытку(ИдПопытки: Строка): ПопыткиЗапросов.Запись?
    возврат (новый ПопыткиЗапросов.КлючЗаписи(ИдПопытки = ИдПопытки)).ЗагрузитьЗапись()
;

метод ПовторПопытки(Попытка: ПопыткиЗапросов.Запись, ИдОперации: Строка, Команда: Строка, Содержимое: Строка): ОтветВызова
    если Попытка.ИдОперации != ИдОперации или Попытка.Команда != Команда или Попытка.СодержимоеJson != Содержимое
        возврат КонтрактApi.Ошибка(409, "ATTEMPT_PAYLOAD_CONFLICT", "attempt_id already belongs to a different command")
    ;
    если Попытка.Исход == "STARTED"
        возврат КонтрактApi.Ошибка(409, "ATTEMPT_IN_PROGRESS", "Read operation state and use a new attempt_id if recovery is needed", Истина)
    ;
    возврат новый ОтветВызова(Код = Попытка.КодОтвета, Тело = Попытка.ОтветJson)
;

метод ЗаблокироватьОперацию(ИдОперации: Строка)
    Блокировки.Заблокировать(новый ВходящиеОперации.Блокировки.КлючЗаписи(ИдОперации = ИдОперации))
;

метод ЗаблокироватьПопытку(ИдПопытки: Строка)
    Блокировки.Заблокировать(новый ПопыткиЗапросов.Блокировки.КлючЗаписи(ИдПопытки = ИдПопытки))
;

метод Событие(ИдОперации: Строка, ИдПрогона: Строка, ИдПопытки: Строка, Вид: Строка)
    СобытияОпераций.Записать(новый СобытияОпераций.Запись(
        ИдСобытия = Ууид.Случайный().ВСтроку(), ИдОперации = ИдОперации,
        ИдПрогона = ИдПрогона, ИдПопытки = ИдПопытки, ТипСобытия = Вид,
        Источник = "ELEMENT", Произошло = Момент.Сейчас()
    ))
;

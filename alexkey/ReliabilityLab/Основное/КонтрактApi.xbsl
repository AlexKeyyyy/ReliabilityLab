импорт Стд::Json
импорт Стд::Коллекции
импорт Стд::Время
импорт Стд::РегулярныеВыражения

@ВПодсистеме
метод Json(Данные: Объект?): Строка
    возврат СериализацияJson.ЗаписатьОбъект(Данные)
;

@ВПодсистеме
метод Ответ(Код: Число, Данные: Объект?): ОтветВызова
    возврат новый ОтветВызова(Код = Код, Тело = Json(Данные))
;

@ВПодсистеме
метод Ошибка(Код: Число, Причина: Строка, Описание: Строка, Повторяемая: Булево = Ложь): ОтветВызова
    возврат Ответ(Код, {"schema_version": 1, "error": {
        "code": Причина, "message": Описание, "retryable": Повторяемая
    }})
;

@ВПодсистеме
метод ПроверитьИд(Значение: Строка)
    если не Значение.ПолноеСовпадение('[A-Za-z0-9_-]{1,96}')
        выбросить новый ИсключениеНедопустимыйАргумент("Expected an ASCII identifier of 1-96 characters")
    ;
;

@ВПодсистеме
метод ПроверитьПопытку(Значение: Строка)
    если не Значение.ПолноеСовпадение('[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}')
        выбросить новый ИсключениеНедопустимыйАргумент("attempt_id must be a lowercase UUID v4")
    ;
;

@ВПодсистеме
метод ПроверитьСообщение(Данные: СообщениеApi): Момент
    если Данные.ВерсияСхемы != 1
        выбросить новый ИсключениеНедопустимыйАргумент("Unsupported schema_version")
    ;
    ПроверитьИд(Данные.ИдОперации)
    ПроверитьИд(Данные.ИдПрогона)
    ПроверитьИд(Данные.ИдЗаказа)
    ПроверитьПопытку(Данные.ИдПопытки)
    если Данные.СуммаВКопейках < 1 или Данные.СуммаВКопейках > 999999999999 или Данные.СуммаВКопейках.ЦелаяЧасть() != Данные.СуммаВКопейках
        выбросить новый ИсключениеНедопустимыйАргумент("amount_minor must be a positive integer of at most 12 digits")
    ;
    если Данные.Валюта != "RUB"
        выбросить новый ИсключениеНедопустимыйАргумент("Only synthetic RUB orders are supported")
    ;
    если не Данные.Создано.ПолноеСовпадение('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z')
        выбросить новый ИсключениеНедопустимыйАргумент("created_at must be UTC RFC 3339 with Z")
    ;
    возврат новый Момент(Данные.Создано)
;

@ВПодсистеме
метод ПроверитьПрогон(Данные: ПрогонApi)
    ПроверитьИд(Данные.ИдПрогона)
    ПроверитьИд(Данные.НаборДанных)
    ПроверитьИд(Данные.ПланСбоев)
    если Данные.Стратегия != "C"
        выбросить новый ИсключениеНедопустимыйАргумент("This first slice supports strategy C only")
    ;
    если Данные.УчебныйРежим
        выбросить новый ИсключениеНедопустимыйАргумент("Unsafe baseline is not enabled in this first slice")
    ;
    если Данные.Сценарий != "normal" и Данные.Сценарий != "fail_before_commit" и Данные.Сценарий != "drop_response_after_commit" и Данные.Сценарий != "duplicate_delivery"
        выбросить новый ИсключениеНедопустимыйАргумент("Unsupported scenario")
    ;
    если Данные.НачальноеЗначение < 0 или Данные.НачальноеЗначение > 2147483647 или Данные.НачальноеЗначение.ЦелаяЧасть() != Данные.НачальноеЗначение
        выбросить новый ИсключениеНедопустимыйАргумент("seed must be a nonnegative 32-bit integer")
    ;
    если Данные.КоличествоОпераций < 1 или Данные.КоличествоОпераций > 500 или Данные.КоличествоОпераций.ЦелаяЧасть() != Данные.КоличествоОпераций
        выбросить новый ИсключениеНедопустимыйАргумент("expected_count must be an integer between 1 and 500")
    ;
    если Данные.Параметры.ТаймаутМс < 1 или Данные.Параметры.ТаймаутМс > 60000 или Данные.Параметры.ТаймаутМс.ЦелаяЧасть() != Данные.Параметры.ТаймаутМс
        выбросить новый ИсключениеНедопустимыйАргумент("http_timeout_ms must be an integer between 1 and 60000")
    ;
    если Данные.Параметры.ЛимитПопыток < 1 или Данные.Параметры.ЛимитПопыток > 10 или Данные.Параметры.ЛимитПопыток.ЦелаяЧасть() != Данные.Параметры.ЛимитПопыток
        выбросить новый ИсключениеНедопустимыйАргумент("max_attempts must be an integer between 1 and 10")
    ;
;

# Copy to .env locally. Do not commit credentials.
# Management API connection used by xbsl-deploy; values from your 1CmyCloud environment.
ELEMENT_BASE_URL=
ELEMENT_CLIENT_ID=
ELEMENT_CLIENT_SECRET=
ELEMENT_APP_ID=
ELEMENT_PROJECT_ID=
ELEMENT_BRANCH=main
ELEMENT_SPACE_ID=
# Published ReliabilityLab HTTP API; different from the management API URL.
RELIABILITYLAB_API_BASE_URL=

# Use an application token or the application client pair for live checks.
# Do not reuse the Console API key.
RELIABILITYLAB_API_TOKEN=
RELIABILITYLAB_CLIENT_ID=
RELIABILITYLAB_CLIENT_SECRET=
